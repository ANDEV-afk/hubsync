PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/hubsync
REDIS_URL=redis://localhost:6379

HUBSPOT_CLIENT_ID=your_hubspot_client_id
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret
HUBSPOT_REDIRECT_URI=http://localhost:4000/auth/hubspot/callback
# The OAuth app must have notes write permission before enabling this.
HUBSPOT_NOTES_SYNC_ENABLED=true

# Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=replace_with_a_32_byte_base64_key

FRONTEND_URL=https://hubsync-fe.vercel.app/

# Optional worker setting. The worker clamps this to a safe maximum.
SYNC_WORKER_CONCURRENCY=1
